# UniFi MCP Server — copy to secrets.env and fill in. secrets.env is git-ignored.

# API key from unifi.ui.com → API (Site Manager). One key covers the cloud and the
# Network API on your consoles through the cloud connector.
UNIFI_API_KEY=your_api_key

# Optional: pin a console and site. Leave empty to auto-discover
# (works when the account has one console and the console has one site).
UNIFI_CONSOLE_ID=
UNIFI_SITE_ID=

# Optional: true registers only tools that never change anything
UNIFI_READ_ONLY=false

# Optional: request timeout in seconds
UNIFI_TIMEOUT_S=30
