{
  "$schema": "https://modelcontextprotocol.io/schemas/agent-card.schema.json",
  "name": "UniFi MCP Server",
  "description": "Cloud-only MCP server for UniFi: one tool for each of the 73 UniFi Network API v10.6.106 operations, reached through the Site Manager cloud connector at api.ui.com, plus the 9 Site Manager API operations and 5 helpers.",
  "version": "0.2.0",
  "url": "https://github.com/ry-ops/unifi-mcp-server",
  "protocol": {
    "type": "mcp",
    "version": "1.0"
  },
  "capabilities": {
    "streaming": false,
    "tasks": false,
    "resources": true,
    "tools": true,
    "prompts": true
  },
  "skills": [
    {
      "name": "site_health",
      "description": "Check the API key, console and Network application, and summarize device states, offline devices, pending firmware and clients.",
      "category": "monitoring",
      "prompts": [
        "check_unifi_health"
      ],
      "tools": [
        "unifi_health",
        "get_site_status",
        "get_latest_adopted_device_statistics",
        "get_application_info"
      ],
      "resources": [
        "unifi://health"
      ],
      "examples": [
        "Is anything on my network offline?",
        "Which devices have firmware updates waiting?"
      ]
    },
    {
      "name": "devices",
      "description": "List, inspect, adopt, remove, restart devices and power-cycle PoE ports.",
      "category": "device_management",
      "prompts": [
        "restart_device"
      ],
      "tools": [
        "list_devices_pending_adoption",
        "list_adopted_devices",
        "adopt_devices",
        "remove_unadopt_device",
        "get_adopted_device_details",
        "execute_adopted_device_action",
        "execute_port_action",
        "get_latest_adopted_device_statistics"
      ],
      "resources": [
        "unifi://sites/{site_id}/devices"
      ],
      "examples": [
        "Restart the laundry access point",
        "Power-cycle port 7 on the office switch"
      ]
    },
    {
      "name": "clients",
      "description": "List connected clients, find one by name, MAC or IP, and authorize or unauthorize guest access.",
      "category": "client_management",
      "prompts": [
        "guest_access"
      ],
      "tools": [
        "list_connected_clients",
        "get_connected_client_details",
        "execute_client_action",
        "search_site"
      ],
      "resources": [
        "unifi://sites/{site_id}/clients"
      ],
      "examples": [
        "Who is on the IoT network?",
        "Give the guest laptop an hour of access"
      ]
    },
    {
      "name": "networks_and_wifi",
      "description": "Create, update and delete networks (VLANs) and Wi-Fi broadcasts, and see what references a network.",
      "category": "configuration",
      "prompts": [],
      "tools": [
        "list_networks",
        "create_network",
        "delete_network",
        "get_network_details",
        "update_network",
        "get_network_references",
        "list_wifi_broadcasts",
        "create_wifi_broadcast",
        "delete_wifi_broadcast",
        "get_wifi_broadcast_details",
        "update_wifi_broadcast"
      ],
      "resources": [],
      "examples": [
        "Add a VLAN 40 network for cameras",
        "Turn off the guest Wi-Fi"
      ]
    },
    {
      "name": "security_policy",
      "description": "Manage firewall zones and policies and their order, ACL rules, DNS policies and traffic matching lists.",
      "category": "security",
      "prompts": [
        "change_firewall_safely"
      ],
      "tools": [
        "list_firewall_policies",
        "create_firewall_policy",
        "get_user_defined_firewall_policy_ordering",
        "reorder_user_defined_firewall_policies",
        "delete_firewall_policy",
        "get_firewall_policy",
        "patch_firewall_policy",
        "update_firewall_policy",
        "list_firewall_zones",
        "create_custom_firewall_zone",
        "delete_custom_firewall_zone",
        "get_firewall_zone",
        "update_firewall_zone",
        "list_acl_rules",
        "create_acl_rule",
        "get_user_defined_acl_rule_ordering",
        "reorder_user_defined_acl_rules",
        "delete_acl_rule",
        "get_acl_rule",
        "update_acl_rule",
        "list_dns_policies",
        "create_dns_policy",
        "delete_dns_policy",
        "get_dns_policy",
        "update_dns_policy",
        "list_traffic_matching_lists",
        "create_traffic_matching_list",
        "delete_traffic_matching_list",
        "get_traffic_matching_list",
        "update_traffic_matching_list"
      ],
      "resources": [],
      "examples": [
        "Block the IoT zone from reaching the LAN",
        "Show the policy order between Internal and External"
      ]
    },
    {
      "name": "hotspot",
      "description": "Generate, list and delete guest vouchers.",
      "category": "guest_access",
      "prompts": [
        "guest_access"
      ],
      "tools": [
        "delete_vouchers",
        "list_vouchers",
        "generate_vouchers",
        "delete_voucher",
        "get_voucher_details"
      ],
      "resources": [],
      "examples": [
        "Make 10 one-day vouchers"
      ]
    },
    {
      "name": "switching_and_reference",
      "description": "Read LAGs, MC-LAG domains, switch stacks, WANs, VPN servers and tunnels, RADIUS profiles, device tags, DPI apps and countries.",
      "category": "inventory",
      "prompts": [],
      "tools": [
        "list_lags",
        "get_lag_details",
        "list_mc_lag_domains",
        "get_mc_lag_domain",
        "list_switch_stacks",
        "get_switch_stack",
        "list_countries",
        "list_dpi_applications",
        "list_dpi_application_categories",
        "list_device_tags",
        "list_radius_profiles",
        "list_vpn_servers",
        "list_site_to_site_vpn_tunnels",
        "list_wan_interfaces",
        "list_local_sites"
      ],
      "resources": [],
      "examples": [
        "List my WAN interfaces",
        "Which VPN servers are configured?"
      ]
    },
    {
      "name": "cloud_account",
      "description": "Consoles, sites and devices across the UniFi account, ISP metrics and SD-WAN configs from Site Manager.",
      "category": "cloud",
      "prompts": [],
      "tools": [
        "cloud_list_devices",
        "cloud_list_hosts",
        "cloud_get_host_by_id",
        "cloud_get_isp_metrics",
        "cloud_query_isp_metrics",
        "cloud_list_sd_wan_configs",
        "cloud_get_sd_wan_config_by_id",
        "cloud_get_sd_wan_config_status",
        "cloud_list_sites"
      ],
      "resources": [],
      "examples": [
        "How was ISP latency over the last day?",
        "List every console on my account"
      ]
    },
    {
      "name": "api_discovery",
      "description": "List every covered operation and fetch the exact request schema before a create or update.",
      "category": "meta",
      "prompts": [],
      "tools": [
        "list_operations",
        "describe_operation"
      ],
      "resources": [],
      "examples": [
        "What fields does create_firewall_policy need?"
      ]
    }
  ],
  "authentication": {
    "required": true,
    "methods": [
      {
        "type": "api_key",
        "name": "unifi_cloud",
        "description": "API key from unifi.ui.com, sent as X-API-KEY to api.ui.com; covers Site Manager and, through the cloud connector, the Network API on the account's consoles.",
        "env_vars": [
          "UNIFI_API_KEY",
          "UNIFI_CONSOLE_ID",
          "UNIFI_SITE_ID"
        ]
      }
    ]
  },
  "requirements": {
    "runtime": "python>=3.12",
    "dependencies": [
      "mcp[cli]>=1.23.0",
      "requests>=2.33.0"
    ],
    "services": [
      "UniFi console with the Network application, linked to unifi.ui.com with remote management on"
    ]
  },
  "integration": {
    "setup": "Add to your MCP client with uv run --directory <path> python main.py",
    "config_example": {
      "mcpServers": {
        "unifi": {
          "command": "uv",
          "args": [
            "run",
            "--directory",
            "/path/to/unifi-mcp-server",
            "python",
            "main.py"
          ]
        }
      }
    }
  },
  "safety": {
    "allowed_hosts": [
      "api.ui.com"
    ],
    "path_parameter_validation": true,
    "read_only_mode": "UNIFI_READ_ONLY=true",
    "tool_annotations": [
      "readOnlyHint",
      "destructiveHint",
      "idempotentHint"
    ],
    "confirmation_required": [
      "reorder_user_defined_acl_rules",
      "delete_acl_rule",
      "update_acl_rule",
      "execute_client_action",
      "remove_unadopt_device",
      "execute_adopted_device_action",
      "execute_port_action",
      "delete_dns_policy",
      "update_dns_policy",
      "reorder_user_defined_firewall_policies",
      "delete_firewall_policy",
      "patch_firewall_policy",
      "update_firewall_policy",
      "delete_custom_firewall_zone",
      "update_firewall_zone",
      "delete_vouchers",
      "delete_voucher",
      "delete_network",
      "update_network",
      "delete_traffic_matching_list",
      "update_traffic_matching_list",
      "delete_wifi_broadcast",
      "update_wifi_broadcast"
    ]
  },
  "metadata": {
    "license": "MIT",
    "repository": "https://github.com/ry-ops/unifi-mcp-server",
    "issues": "https://github.com/ry-ops/unifi-mcp-server/issues",
    "documentation": "https://github.com/ry-ops/unifi-mcp-server/blob/main/README.md",
    "playbook": "https://github.com/ry-ops/unifi-mcp-server/blob/main/NETWORK_PLAYBOOK.md",
    "api_specs": [
      "https://developer.ui.com/network/v10.6.106/openapi.json",
      "https://developer.ui.com/site-manager/v1.0.0/openapi.json"
    ]
  }
}
